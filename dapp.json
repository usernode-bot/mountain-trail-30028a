{
  "description": "An offline trail guide and safety companion for hikers",
  "icon": {
    "image": "brand/icon.png",
    "emoji": "⛰️"
  },
  "secrets": [],
  "visibility": {
    "build": "public",
    "view": "public"
  },
  "admins": [
    "dendiharyawan"
  ],
  "permissions": [
    {
      "capability": "geolocation",
      "reason": "Reads your position when you tap Update my location, to share it with basecamp, pick the stop you report from, and save it to Mountain Trail"
    }
  ],
  "tests": [
    {
      "name": "Trail guide renders",
      "path": "/",
      "expectSelector": "#trail-line"
    },
    {
      "name": "Mountain banner shows the summit height and its chips",
      "path": "/",
      "expectText": "Jarak 9,6 km",
      "expectSelector": "#mtn-hero #mtn-distance"
    },
    {
      "name": "Colour mode button sits in the mountain banner",
      "path": "/",
      "expectSelector": "#mtn-hero #theme-btn"
    },
    {
      "name": "Report tab opens under a mountain banner",
      "path": "/#report",
      "expectSelector": "#tab-report .banner-title"
    },
    {
      "name": "Trail tab shows the route difficulty",
      "path": "/",
      "expectText": "Tingkat kesulitan: Sulit",
      "expectSelector": "#mtn-difficulty .diff-meter"
    },
    {
      "name": "Profile stop labels",
      "path": "/",
      "expectText": "km 0, start"
    },
    {
      "id": "trail.demo",
      "name": "Populated demo",
      "path": "/?demo=1",
      "expectText": "Demo staging",
      "visual": true,
      "impact": [
        "public/**",
        "server.js",
        "styles/**",
        "tailwind.config.js"
      ]
    },
    {
      "name": "Report tab",
      "path": "/#report",
      "expectSelector": "#condition-buttons"
    },
    {
      "name": "Packing tab",
      "path": "/#packing",
      "expectText": "Milik rombongan"
    },
    {
      "name": "Location tab",
      "path": "/#location",
      "expectText": "Bagikan ke basecamp"
    },
    {
      "name": "Location tab sends by WhatsApp or SMS",
      "path": "/#location",
      "expectSelector": "#wa-btn"
    },
    {
      "name": "Location demo shows a waiting message",
      "path": "/?demo=1#location",
      "expectText": "Menunggu sinyal"
    },
    {
      "name": "Trail tab demo shows the status banner, permits and weather",
      "path": "/?demo=1",
      "expectText": "Dibuka Terbatas",
      "expectSelector": "#permits-card"
    },
    {
      "name": "Trail tab demo shows the weather card",
      "path": "/?demo=1",
      "expectText": "Cuaca basecamp dan puncak",
      "expectSelector": "#weather-card"
    },
    {
      "name": "Trail tab offers saving reports for offline",
      "path": "/?demo=1",
      "expectText": "Simpan laporan untuk offline",
      "expectSelector": "#offline-save"
    },
    {
      "name": "Trail tab demo shows the notifications section",
      "path": "/?demo=1",
      "expectText": "Notifikasi",
      "expectSelector": "#notif-list"
    },
    {
      "name": "Report tab demo shows the new condition buttons",
      "path": "/?demo=1#report",
      "expectText": "Pohon tumbang"
    },
    {
      "name": "Report tab demo offers the still-valid confirmation",
      "path": "/?demo=1#report",
      "expectText": "Masih berlaku"
    },
    {
      "name": "Catalog offers the language picker, Indonesian by default",
      "path": "/#mountains",
      "expectText": "Tersimpan",
      "expectSelector": "#lang-btn[aria-label^='Bahasa: Bahasa Indonesia']"
    },
    {
      "name": "Mountains catalog opens with search",
      "path": "/#mountains",
      "expectText": "Gunung di Indonesia",
      "expectSelector": "#mountain-search"
    },
    {
      "name": "Catalog groups by island and carries the estimate label",
      "path": "/#mountains",
      "expectText": "Nusa Tenggara",
      "expectSelector": "#catalog-results"
    },
    {
      "name": "Catalog shows the estimate label",
      "path": "/#mountains",
      "expectText": "Perkiraan, bukan survei"
    },
    {
      "name": "A mountain opens its own guide",
      "path": "/?mountain=semeru",
      "expectText": "Jalur Ranu Pane ke Mahameru",
      "expectSelector": "#trail-line"
    },
    {
      "name": "A mountain guide offers saving",
      "path": "/?mountain=semeru",
      "expectText": "Simpan panduan",
      "expectSelector": "#guide-save"
    },
    {
      "id": "catalog.demo",
      "name": "Populated catalog demo",
      "path": "/?demo=1#mountains",
      "expectText": "Demo staging",
      "expectSelector": "#catalog-results",
      "visual": true,
      "impact": [
        "public/**",
        "server.js",
        "styles/**",
        "tailwind.config.js"
      ]
    },
    {
      "name": "Demo mountain shows its own reports",
      "path": "/?demo=1&mountain=semeru",
      "expectText": "Kabut tebal di Ranu Kumbolo",
      "expectSelector": "#status-strip"
    }
  ]
}
